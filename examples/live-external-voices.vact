# Opt-in instrument-local host input. Requires a connected stereo input; disconnected lanes are zero.
# Rings sums both lanes at half gain for mono excitation. Elements uses left blow and right strike.
# These are original procedural adaptations, not source-firmware audio ports.
# Elements starts with `ex-gate`, `ex-blow-level`, and `ex-strike-level` at 1.
# Pattern controls can mute the gate or scale either external exciter.

inst resonator-external-voice reso-model: float = 0 reso-structure: float = 0.5 reso-brightness: float = 0.5 reso-damping: float = 0.5 reso-position: float = 0.5 reso-strum: float = 1 reso-internal-exciter: float = 0 reso-internal-strum: float = 1 reso-internal-note: float = 1 reso-tonic: float = 0 reso-note: float = 0 reso-fm: float = 0 reso-chord: float = 0 reso-polyphony: float = 1:
	resonator-part-core freq reso-model: reso-model reso-structure: reso-structure reso-brightness: reso-brightness reso-damping: reso-damping reso-position: reso-position reso-strum: reso-strum reso-internal-exciter: reso-internal-exciter reso-internal-strum: reso-internal-strum reso-internal-note: reso-internal-note reso-tonic: reso-tonic reso-note: reso-note reso-fm: reso-fm reso-chord: reso-chord reso-polyphony: reso-polyphony reso-external-in: {host-in-l 0 > + {host-in-r 0 > * 1} > * 0.5} mode: 0 > * amp
		> + {resonator-part-core freq reso-model: reso-model reso-structure: reso-structure reso-brightness: reso-brightness reso-damping: reso-damping reso-position: reso-position reso-strum: reso-strum reso-internal-exciter: reso-internal-exciter reso-internal-strum: reso-internal-strum reso-internal-note: reso-internal-note reso-tonic: reso-tonic reso-note: reso-note reso-fm: reso-fm reso-chord: reso-chord reso-polyphony: reso-polyphony reso-external-in: {host-in-l 0 > + {host-in-r 0 > * 1} > * 0.5} mode: 1 > * amp > aux-out}

inst exciter-external-voice ex-env-shape: float = 0.5 ex-bow-level: float = 0 ex-bow-timbre: float = 0.5 ex-blow-level: float = 1 ex-blow-meta: float = 0.5 ex-blow-timbre: float = 0.5 ex-strike-level: float = 1 ex-strike-meta: float = 0.5 ex-strike-timbre: float = 0.5 ex-signature: float = 0.5 ex-geometry: float = 0.5 ex-brightness: float = 0.5 ex-damping: float = 0.5 ex-position: float = 0.5 ex-res-mod-frequency: float = 0.5 ex-res-mod-offset: float = 0.5 ex-reverb-diffusion: float = 0.5 ex-reverb-lp: float = 0.5 ex-space: float = 0.5 ex-modulation-frequency: float = 0.5 ex-gate: float = 1 ex-note: float = 0 ex-modulation: float = 0 ex-strength: float = 1 ex-model: float = 0 ex-alternate: float = 0:
	exciter-core freq ex-env-shape: ex-env-shape ex-bow-level: ex-bow-level ex-bow-timbre: ex-bow-timbre ex-blow-level: ex-blow-level ex-blow-meta: ex-blow-meta ex-blow-timbre: ex-blow-timbre ex-strike-level: ex-strike-level ex-strike-meta: ex-strike-meta ex-strike-timbre: ex-strike-timbre ex-signature: ex-signature ex-geometry: ex-geometry ex-brightness: ex-brightness ex-damping: ex-damping ex-position: ex-position ex-res-mod-frequency: ex-res-mod-frequency ex-res-mod-offset: ex-res-mod-offset ex-reverb-diffusion: ex-reverb-diffusion ex-reverb-lp: ex-reverb-lp ex-space: ex-space ex-modulation-frequency: ex-modulation-frequency ex-gate: ex-gate ex-note: ex-note ex-modulation: ex-modulation ex-strength: ex-strength ex-model: ex-model ex-alternate: ex-alternate ex-external-blow: {host-in-l 0 > * 1} ex-external-strike: {host-in-r 0 > * 1} mode: 0 > * amp
		> + {exciter-core freq ex-env-shape: ex-env-shape ex-bow-level: ex-bow-level ex-bow-timbre: ex-bow-timbre ex-blow-level: ex-blow-level ex-blow-meta: ex-blow-meta ex-blow-timbre: ex-blow-timbre ex-strike-level: ex-strike-level ex-strike-meta: ex-strike-meta ex-strike-timbre: ex-strike-timbre ex-signature: ex-signature ex-geometry: ex-geometry ex-brightness: ex-brightness ex-damping: ex-damping ex-position: ex-position ex-res-mod-frequency: ex-res-mod-frequency ex-res-mod-offset: ex-res-mod-offset ex-reverb-diffusion: ex-reverb-diffusion ex-reverb-lp: ex-reverb-lp ex-space: ex-space ex-modulation-frequency: ex-modulation-frequency ex-gate: ex-gate ex-note: ex-note ex-modulation: ex-modulation ex-strength: ex-strength ex-model: ex-model ex-alternate: ex-alternate ex-external-blow: {host-in-l 0 > * 1} ex-external-strike: {host-in-r 0 > * 1} mode: 1 > * amp > aux-out}
