# Opt-in instrument-local host input. Requires a connected stereo input; disconnected lanes are zero.
# Rings sums both lanes at half gain for mono excitation. Elements uses left blow and right strike.
# These are original procedural adaptations, not source-firmware audio ports.
# Elements starts with `el-gate`, `el-blow-level`, and `el-strike-level` at 1.
# Pattern controls can mute the gate or scale either external exciter.

inst rings-external-voice rings-model: float = 0 rings-structure: float = 0.5 rings-brightness: float = 0.5 rings-damping: float = 0.5 rings-position: float = 0.5 rings-strum: float = 1 rings-internal-exciter: float = 0 rings-internal-strum: float = 1 rings-internal-note: float = 1 rings-tonic: float = 0 rings-note: float = 0 rings-fm: float = 0 rings-chord: float = 0 rings-polyphony: float = 1:
	rings-part-core freq rings-model: rings-model rings-structure: rings-structure rings-brightness: rings-brightness rings-damping: rings-damping rings-position: rings-position rings-strum: rings-strum rings-internal-exciter: rings-internal-exciter rings-internal-strum: rings-internal-strum rings-internal-note: rings-internal-note rings-tonic: rings-tonic rings-note: rings-note rings-fm: rings-fm rings-chord: rings-chord rings-polyphony: rings-polyphony rings-external-in: {host-in-l 0 > + {host-in-r 0 > * 1} > * 0.5} mode: 0 > * amp
		> + {rings-part-core freq rings-model: rings-model rings-structure: rings-structure rings-brightness: rings-brightness rings-damping: rings-damping rings-position: rings-position rings-strum: rings-strum rings-internal-exciter: rings-internal-exciter rings-internal-strum: rings-internal-strum rings-internal-note: rings-internal-note rings-tonic: rings-tonic rings-note: rings-note rings-fm: rings-fm rings-chord: rings-chord rings-polyphony: rings-polyphony rings-external-in: {host-in-l 0 > + {host-in-r 0 > * 1} > * 0.5} mode: 1 > * amp > aux-out}

inst elements-external-voice el-env-shape: float = 0.5 el-bow-level: float = 0 el-bow-timbre: float = 0.5 el-blow-level: float = 1 el-blow-meta: float = 0.5 el-blow-timbre: float = 0.5 el-strike-level: float = 1 el-strike-meta: float = 0.5 el-strike-timbre: float = 0.5 el-signature: float = 0.5 el-geometry: float = 0.5 el-brightness: float = 0.5 el-damping: float = 0.5 el-position: float = 0.5 el-res-mod-frequency: float = 0.5 el-res-mod-offset: float = 0.5 el-reverb-diffusion: float = 0.5 el-reverb-lp: float = 0.5 el-space: float = 0.5 el-modulation-frequency: float = 0.5 el-gate: float = 1 el-note: float = 0 el-modulation: float = 0 el-strength: float = 1 el-model: float = 0 el-alternate: float = 0:
	elements-internal-core freq el-env-shape: el-env-shape el-bow-level: el-bow-level el-bow-timbre: el-bow-timbre el-blow-level: el-blow-level el-blow-meta: el-blow-meta el-blow-timbre: el-blow-timbre el-strike-level: el-strike-level el-strike-meta: el-strike-meta el-strike-timbre: el-strike-timbre el-signature: el-signature el-geometry: el-geometry el-brightness: el-brightness el-damping: el-damping el-position: el-position el-res-mod-frequency: el-res-mod-frequency el-res-mod-offset: el-res-mod-offset el-reverb-diffusion: el-reverb-diffusion el-reverb-lp: el-reverb-lp el-space: el-space el-modulation-frequency: el-modulation-frequency el-gate: el-gate el-note: el-note el-modulation: el-modulation el-strength: el-strength el-model: el-model el-alternate: el-alternate el-external-blow: {host-in-l 0 > * 1} el-external-strike: {host-in-r 0 > * 1} mode: 0 > * amp
		> + {elements-internal-core freq el-env-shape: el-env-shape el-bow-level: el-bow-level el-bow-timbre: el-bow-timbre el-blow-level: el-blow-level el-blow-meta: el-blow-meta el-blow-timbre: el-blow-timbre el-strike-level: el-strike-level el-strike-meta: el-strike-meta el-strike-timbre: el-strike-timbre el-signature: el-signature el-geometry: el-geometry el-brightness: el-brightness el-damping: el-damping el-position: el-position el-res-mod-frequency: el-res-mod-frequency el-res-mod-offset: el-res-mod-offset el-reverb-diffusion: el-reverb-diffusion el-reverb-lp: el-reverb-lp el-space: el-space el-modulation-frequency: el-modulation-frequency el-gate: el-gate el-note: el-note el-modulation: el-modulation el-strength: el-strength el-model: el-model el-alternate: el-alternate el-external-blow: {host-in-l 0 > * 1} el-external-strike: {host-in-r 0 > * 1} mode: 1 > * amp > aux-out}
