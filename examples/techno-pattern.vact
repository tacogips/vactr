# Techno pattern (the last-played version): Peaks FM drum with Mutable Instruments voice
# adaptations (Plaits FM pair, analog pair, string, and metallic dual hat).
# Evaluate the whole file, then re-evaluate individual lines while it plays.
# Eight parts: kick, backbeat, closed hats, bass, stabs, texture, rumble,
# and open hats. The metallic fill changes every fourth bar.

# Declare the voices locally so the checker and sound resolver both know them.
inst industrial-drum fm-amount: float = 1.5 pitch-sweep: float = 0.5 decay: float = 0.4 drum-noise: float = 0 drive: float = 0:
	fm-drum freq fm-amount: fm-amount pitch-sweep: pitch-sweep decay: decay drum-noise: drum-noise drive: drive
		> * amp

inst industrial-hat hat-harmonics: float = 0.5 timbre: float = 0.5 morph: float = 0.5 hat-sustain: float = 0 lpg-mode: keyword = :off lpg-decay: float = 0.5 lpg-color: float = 0.5:
	hat-pair-core freq hat-harmonics: hat-harmonics timbre: timbre morph: morph velocity: velocity mode: 0 hat-sustain: hat-sustain > * amp
		> + {hat-pair-core freq hat-harmonics: hat-harmonics timbre: timbre morph: morph velocity: velocity mode: 1 hat-sustain: hat-sustain > * amp > vactrol-gate freq velocity lpg-mode: lpg-mode lpg-decay: lpg-decay lpg-color: lpg-color slot: 23 lane: 1 > aux-out}
		> vactrol-gate freq velocity lpg-mode: lpg-mode lpg-decay: lpg-decay lpg-color: lpg-color slot: 23 lane: 0

inst industrial-bass fm-harmonics: float = 0.5 timbre: float = 0.5 morph: float = 0.5 lpg-mode: keyword = :off lpg-decay: float = 0.5 lpg-color: float = 0.5:
	let p {fm-pair freq fm-harmonics: fm-harmonics timbre: timbre morph: morph mode: 0}
	{p :main} > * amp > + {{p :aux} > * amp > vactrol-gate freq velocity lpg-mode: lpg-mode lpg-decay: lpg-decay lpg-color: lpg-color slot: 10 lane: 1 > aux-out}
		> vactrol-gate freq velocity lpg-mode: lpg-mode lpg-decay: lpg-decay lpg-color: lpg-color slot: 10 lane: 0

inst industrial-stab analog-detune: float = 0.5 timbre: float = 0.5 morph: float = 0.5 lpg-mode: keyword = :off lpg-decay: float = 0.5 lpg-color: float = 0.5:
	let p {analog-pair-core freq analog-detune: analog-detune timbre: timbre morph: morph mode: 0}
	{p :main} > * amp > + {{p :aux} > * amp > vactrol-gate freq velocity lpg-mode: lpg-mode lpg-decay: lpg-decay lpg-color: lpg-color slot: 8 lane: 1 > aux-out}
		> vactrol-gate freq velocity lpg-mode: lpg-mode lpg-decay: lpg-decay lpg-color: lpg-color slot: 8 lane: 0

inst industrial-texture string-structure: float = 0.5 timbre: float = 0.5 morph: float = 0.5 string-sustain: float = 0 lpg-mode: keyword = :off lpg-decay: float = 0.5 lpg-color: float = 0.5:
	string-pair-core freq string-structure: string-structure timbre: timbre morph: morph velocity: velocity mode: 0 string-sustain: string-sustain > * amp
		> + {string-pair-core freq string-structure: string-structure timbre: timbre morph: morph velocity: velocity mode: 1 string-sustain: string-sustain > * amp > vactrol-gate freq velocity lpg-mode: lpg-mode lpg-decay: lpg-decay lpg-color: lpg-color slot: 19 lane: 1 > aux-out}
		> vactrol-gate freq velocity lpg-mode: lpg-mode lpg-decay: lpg-decay lpg-color: lpg-color slot: 19 lane: 0

use-bpm 138

# A firm 49 Hz kick: short pitch snap, little noise, and a driven body.
s :industrial-drum > note [:g1 :g1 :g1 :g1] > fm-amount 7 > pitch-sweep 2.6 > decay 0.27 > drum-noise 0.025 > drive 0.42 > gain 0.78 > d1

# Noisy backbeat, with a short double hit at the end of every fourth bar.
s :industrial-drum > note [nil :g3 nil {alt [:g3 nil] [:g3 nil] [:g3 nil] [:g3 :eb4]}] > fm-amount 11 > pitch-sweep 1.2 > decay 0.13 > drum-noise 0.58 > drive 0.65 > hpf 650 > room 0.14 > size 0.45 > gain 0.3 > d2

# Sixteenth-note hat pattern; stronger offbeats give the grid a pulse.
s :industrial-hat > note [:a5 :a5 :a5 nil :a5 :a5 :a5 :a5 :a5 nil :a5 :a5 :a5 :a5 :a5 :a5] > hat-harmonics 0.78 > timbre 0.64 > morph 0.16 > hpf 5500 > gain [0.09 0.05 0.18 0.06] > pan 0.43 > d3

# Short FM bass answers the kick instead of starting on each downbeat.
s :industrial-bass > note [nil :c2 nil [:c2 :eb2] nil :c2 nil {alt :bb1 :g1}] > fm-harmonics 0.62 > timbre {range sine 0.24 0.46} > morph 0.58 > lpg-mode :ping > lpg-decay 0.16 > lpg-color 0.62 > hpf 65 > lpf 1700 > gain 0.3 > d4

# Sparse, detuned stabs with a dotted-eighth echo (0.326 s at 138 BPM).
s :industrial-stab > note [nil nil :c3 nil nil :eb3 nil :bb2] > analog-detune 0.66 > timbre {range sine 0.42 0.64} > morph 0.38 > lpg-mode :ping > lpg-decay 0.12 > lpg-color 0.66 > hpf 280 > delay 0.18 > delaytime 0.326 > delayfeedback 0.28 > pan 0.58 > gain 0.19 > d5

# A restrained bowed-metal texture; one trigger every four bars.
s :industrial-texture > note [:c4] > slow 4 > string-structure 0.82 > string-sustain 0.6 > timbre {range sine 0.3 0.58} > morph 0.72 > hpf 700 > room 0.45 > size 0.78 > pan {range sine 0.3 0.7} > gain 0.07 > d6

# Rolling low FM tail between the main kicks, kept quiet and band-limited.
s :industrial-drum > note [nil :c2 nil :c2 nil :g1 nil [:c2 :c2]] > fm-amount 3.5 > pitch-sweep 0.3 > decay 0.38 > drum-noise 0.035 > drive 0.55 > hpf 40 > lpf 220 > gain 0.16 > d7

# Longer open hats on the offbeats, leaving room for the dry tick layer.
s :industrial-hat > note [nil :a5 nil :a5] > hat-harmonics 0.86 > timbre 0.72 > morph 0.65 > hpf 6500 > room 0.1 > size 0.38 > pan 0.62 > gain 0.13 > d8
