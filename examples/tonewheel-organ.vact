# Three drawbar registrations through the existing rotary effect bus.
use-bpm 112

bus :leslie:
	rotary speed: 6 depth: 0.7 mix: 1

# 888000000: 16', 5 1/3', and 8' drawbars.
s :tonewheel-organ > note [:c3 :eb3 :g3 :bb3] > drawbar1 8 > drawbar2 8 > drawbar3 8 > drawbar4 0 > drawbar5 0 > drawbar6 0 > drawbar7 0 > drawbar8 0 > drawbar9 0 > organ-perc 0 > organ-vibrato 2 > gate-length 4 > gain 0.2 > bus :leslie > d1
# 838000000: reduce the second drawbar.
s :tonewheel-organ > note [:c4 :eb4 :g4 :bb4] > drawbar1 8 > drawbar2 3 > drawbar3 8 > drawbar4 0 > drawbar5 0 > drawbar6 0 > drawbar7 0 > drawbar8 0 > drawbar9 0 > organ-perc 2 > organ-perc-trigger [1 0 0 0] > organ-vibrato 6 > gate-length 4 > gain 0.13 > bus :leslie > d2
# 886000000: a slightly softer third drawbar.
s :tonewheel-organ > note [:g3 :bb3 :d4 :g4] > drawbar1 8 > drawbar2 8 > drawbar3 6 > drawbar4 0 > drawbar5 0 > drawbar6 0 > drawbar7 0 > drawbar8 0 > drawbar9 0 > organ-perc 0 > organ-vibrato 4 > gate-length 4 > gain 0.16 > bus :leslie > d3
