let bass-bar-2 [:bb2 nil :bb2 nil]
let bass-bar-3 [:c2 nil :c2 nil]
let bass-line {cat [bass-bar-0 bass-bar-1 bass-bar-2 bass-bar-3 bass-bar-0 bass-bar-1 bass-bar-2 bass-bar-3 bass-bar-0 bass-bar-1 bass-bar-2 bass-bar-3 bass-bar-0 bass-bar-1 bass-bar-2 bass-bar-3 bass-bar-0 bass-bar-1 bass-bar-2 bass-bar-3 bass-bar-0 bass-bar-1 bass-bar-2 bass-bar-3 bass-bar-2 bass-bar-1 bass-bar-0 bass-bar-3 bass-bar-2 bass-bar-1 bass-bar-0 bass-bar-3 bass-bar-0 bass-bar-2 bass-bar-1 bass-bar-3 bass-bar-0 bass-bar-2 bass-bar-1 bass-bar-3 bass-bar-0 bass-bar-2 bass-bar-1 bass-bar-3 bass-bar-0 bass-bar-2 bass-bar-1 bass-bar-3 bass-bar-0 bass-bar-1 bass-bar-2 bass-bar-3 bass-bar-0 bass-bar-1 bass-bar-2 bass-bar-3 bass-bar-0 bass-bar-1 bass-bar-2 bass-bar-3 bass-bar-2 bass-bar-1 bass-bar-3 bass-bar-0]}

s :score-pad > chord changes > voicing > score-brightness 1400 > score-air 0.12 > legato 1.1 > gain {slow [0.015 0.015 0.015 0.015 0.015 0.015 0.015 0.015 0.025 0.025 0.025 0.025 0.025 0.025 0.025 0.025 0.025 0.025 0.025 0.025 0.025 0.025 0.025 0.025 0.01625 0.01625 0.01625 0.01625 0.01625 0.01625 0.01625 0.01625 0.0225 0.0225 0.0225 0.0225 0.0225 0.0225 0.0225 0.0225 0.025 0.025 0.025 0.025 0.025 0.025 0.025 0.025 0.02125 0.02125 0.02125 0.02125 0.02125 0.02125 0.02125 0.02125 0.0075 0.0075 0.00637 0.00525 0.00413 0.003 0.00187 0.0009] 64} > pan 0.43 > bus :air > d1

