# Amber Notebook — original instrumental lofi-hiphop, 78 BPM, E minor.
# Warm minor ninths, a sparse backbeat and a descending electric-key answer.
# 64 bars: intro / verse / lift / space / answer / lift / reprise / fade.
# Play: target/debug/vactr run examples/tracks/lofi-hiphop/amber-notebook.vact --host native --cycles 64

# Local voices make each file self-contained. All sounds are synthesized.
inst score-kick score-punch: float = 1.8 score-body: float = 0.22:
	fm-drum freq fm-amount: 0.4 pitch-sweep: score-punch decay: score-body drum-noise: 0.01 drive: 0.12 > * amp

inst score-snare grit: float = 0.5 score-body: float = 0.14:
	{gaussian-noise 0.5 > * grit} > + {* {sin-osc {* freq 2.5}} 0.3}
		> hpf 180 > lpf 5400 > * {env-perc 0.001 score-body} > * amp

inst score-hat score-body: float = 0.055:
	gaussian-noise 0.5 > hpf 3800 > lpf 8500 > * {env-perc 0.001 score-body} > * amp

inst score-bass score-brightness: float = 800 score-roundness: float = 0.6:
	{sin-osc freq > * score-roundness} > + {saw freq > * {- 1 score-roundness}}
		> lpf score-brightness > * {env-adsr 0.008 0.12 0.7 0.18} > * amp

inst score-keys score-color: float = 1.5 score-softness: float = 0.65:
	fm-op freq ratio: 1 index: {* score-color {env-perc 0.002 score-softness}}
		> fm-mod {fm-op freq ratio: 2 index: 0.25}
		> * {env-perc 0.005 score-softness} > * amp

inst score-pad score-brightness: float = 1900 score-air: float = 0.35:
	{tri freq > * 0.6} > + {sin-osc {* freq 1.003} > * 0.4}
		> + {sin-osc {* freq 2.001} > * score-air}
		> lpf score-brightness > * {env-adsr 0.6 0.8 0.75 1.8} > * amp

inst score-lead score-warmth: float = 0.7 score-tail: float = 0.28:
	{sin-osc freq > * score-warmth} > + {tri freq > * {- 1 score-warmth}}
		> * {env-perc 0.008 score-tail} > * amp


use-bpm 78

bus :kick:
	gain 0

bus :music:
	hpf cutoff: 30

bus :air:
	lofi tone: 5100 drive: 1.64 wow: 0.12 flutter: 0.04 bits: 12 rate: 22050 hiss: 0.1 crackle: 0.1 mix: 0.8
		> tape-delay time: 0.385 feedback: 0.23 tone: 3060 wow: 0.06 mix: 0.12
		> schroeder-reverb size: 0.45 decay: 1.9 damping: 0.65 mix: 0.2 > hpf cutoff: 100

master:
	compressor threshold: -14 ratio: 1.5 attack: 0.03 release: 0.18 knee: 6
		> limiter ceiling: -2 release: 0.08

let changes {alt [:e3 :m9] [:c3 :maj7] [:a3 :m7] [:b3 :dom7] [:e3 :m9] [:c3 :maj7] [:a3 :m7] [:b3 :dom7] [:e3 :m9] [:c3 :maj7] [:a3 :m7] [:b3 :dom7] [:e3 :m9] [:c3 :maj7] [:a3 :m7] [:b3 :dom7] [:e3 :m9] [:c3 :maj7] [:a3 :m7] [:b3 :dom7] [:e3 :m9] [:c3 :maj7] [:a3 :m7] [:b3 :dom7] [:a3 :m7] [:c3 :maj7] [:e3 :m9] [:b3 :dom7] [:a3 :m7] [:c3 :maj7] [:e3 :m9] [:b3 :dom7] [:e3 :m9] [:a3 :m7] [:c3 :maj7] [:b3 :dom7] [:e3 :m9] [:a3 :m7] [:c3 :maj7] [:b3 :dom7] [:e3 :m9] [:a3 :m7] [:c3 :maj7] [:b3 :dom7] [:e3 :m9] [:a3 :m7] [:c3 :maj7] [:b3 :dom7] [:e3 :m9] [:c3 :maj7] [:a3 :m7] [:b3 :dom7] [:e3 :m9] [:c3 :maj7] [:a3 :m7] [:b3 :dom7] [:e3 :m9] [:c3 :maj7] [:a3 :m7] [:b3 :dom7] [:a3 :m7] [:c3 :maj7] [:b3 :dom7] [:e3 :m9]}
let phrase-a [:g5 nil :fs5 :e5 nil :b4 :d5 nil]
let phrase-b [:b4 :d5 nil :g5 :fs5 nil :e5 nil]
let cadence [:e5 nil nil nil]
let motif {cat [phrase-a phrase-a phrase-a phrase-a phrase-a phrase-a phrase-a phrase-b phrase-a phrase-a phrase-a phrase-a phrase-a phrase-a phrase-a phrase-b phrase-a phrase-a phrase-a phrase-a phrase-a phrase-a phrase-a phrase-b phrase-b phrase-b phrase-b phrase-b phrase-b phrase-b phrase-b phrase-b phrase-b phrase-b phrase-b phrase-b phrase-b phrase-b phrase-b phrase-b phrase-b phrase-b phrase-b phrase-b phrase-b phrase-b phrase-b phrase-b phrase-a phrase-a phrase-a phrase-a phrase-a phrase-a phrase-a phrase-b phrase-a phrase-a phrase-a phrase-a phrase-a phrase-a phrase-a cadence]}
