		> vactrol-gate freq velocity lpg-mode: lpg-mode lpg-decay: lpg-decay lpg-color: lpg-color slot: 14 lane: 0

# Five original analytic oscillator shapes selected by macro-shape (0..4).
# Strike adds a short overtone transient; sync adds an event-local hard-sync clock.
inst macro-five-voice macro-shape: float = 0 macro-color: float = 0.5 macro-timbre: float = 0.5 macro-strike: float = 0 macro-sync: float = 0:
	macro-five-core freq macro-shape: macro-shape macro-color: macro-color macro-timbre: macro-timbre macro-strike: macro-strike macro-sync: macro-sync > * amp

# Original analytic sub-octave and dual-sync shapes, source positions 5..8.
