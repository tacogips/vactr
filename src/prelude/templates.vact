# Prelude synthesis templates (design-music.md sections 4 and 6; design
# 12.4, 12.8.6). Each is an ordinary `inst`, realized to an `InstDef` when
# the session starts; `s :analog` plays it. Header parameters are controls
# (M3), so every knob is patternable; free control names in a body
# (`freq`, `amp`, `attack`, `n`, ..) are implicit controls (B2). The plain
# header form is used, not `inst drum: sampler ...:` (B3).

# sample playback: the host bank by keyword, the sample index by `n`
inst sampler bank: keyword = :bd-haus begin: float = 0 end: float = 1 loop: bool = false:
	sample-play bank n: n rate: speed begin: begin end: end loop: loop
		> * {env-perc attack release}
		> * amp

# analog modeling: drifting oscillator with unison, sub oscillator, ladder
inst analog wave: keyword = :saw cutoff: float = 1200 res: float = 0.3 unison: int = 1 detune: float = 0.1:
	vco wave freq unison: unison detune: detune drift: 0.002
		> + {* {sub-osc freq} 0.3}
		> ladder cutoff res
		> * {env-adsr attack decay sustain release}
		> * amp

# FM: two operators with ratio and index
inst fm algorithm: int = 5 ratio: float = 14 index: float = 2:
	fm-op freq ratio: 1 index: {* index {env-perc 0.01 0.8}}
		> fm-mod {fm-op freq ratio: ratio}
		> * {env-adsr attack decay sustain release}
		> * amp

# Analytic triggered FM percussion; every sound control can be patterned.
inst phase-drum fm-amount: float = 1.5 pitch-sweep: float = 0.5 decay: float = 0.4 drum-noise: float = 0 drive: float = 0:
	fm-drum freq fm-amount: fm-amount pitch-sweep: pitch-sweep decay: decay drum-noise: drum-noise drive: drive
		> * amp

# Original coupled-FM percussion with modulator feedback and noise excitation.
inst feedback-metal-drum metal-ratio: float = 2.4 metal-index: float = 3 metal-feedback: float = 0.35 metal-mod-decay: float = 0.16 metal-body-decay: float = 0.42 metal-pitch-drop: float = 0.5 metal-noise-level: float = 0.18 metal-noise-decay: float = 0.075 metal-noise-color: float = 5000 metal-noise-to-fm: float = 0.45 metal-cutoff: float = 1800 metal-resonance: float = 1.5 metal-drive: float = 0.22:
	feedback-metal-core freq velocity metal-ratio: metal-ratio metal-index: metal-index metal-feedback: metal-feedback metal-mod-decay: metal-mod-decay metal-body-decay: metal-body-decay metal-pitch-drop: metal-pitch-drop metal-noise-level: metal-noise-level metal-noise-decay: metal-noise-decay metal-noise-color: metal-noise-color metal-noise-to-fm: metal-noise-to-fm metal-cutoff: metal-cutoff metal-resonance: metal-resonance metal-drive: metal-drive
		> * amp

# Original programmable digital drum kit: tonal voice (design-music 4.1,
# DDRUM-001/003). Every parameter of `digital-drum-core` is a header
# control, so it is patternable, cell-backed and editor-visible; `cps` and
# `onset-time` are hidden implicit controls the commit stage fills for
# `lfo-sync`/`lfo-retrigger: false` (see `dsp::ugen::digital_drum`).
# `filter-type` defaults to `:lp` (not `:off`), so `cutoff`/`res` and the
# `velocity-target`/`lfo-target` routes to them are live out of the box;
# `:off` remains one keyword away for a fully unfiltered voice.
inst digital-drum wave: keyword = :sine coarse: float = 0 fine: float = 0 amp-attack: float = 0.001 amp-decay: float = 0.3 amp-slope: float = 0.6 mod-wave: keyword = :sine mod-freq: float = 2 mod-level: float = 0.5 fm-depth: float = 1 pitch-decay: float = 0.05 pitch-depth: float = 12 pitch-slope: float = 0.5 osc-mix: float = 0.5 mod-decay: float = 0.15 mod-slope: float = 0.5 transient-wave: keyword = :click transient-freq: float = 4000 transient-level: float = 0.3 filter-type: keyword = :lp cutoff: float = 1200 res: float = 0.3 filter-drive: float = 0 drive: float = 0 decimation: float = 0 volume-velocity: float = 1 velocity-depth: float = 0 velocity-target: keyword = :none lfo-wave: keyword = :sine lfo-rate: float = 4 lfo-depth: float = 0 lfo-offset: float = 0 lfo-target: keyword = :none lfo-retrigger: bool = true lfo-sync: bool = false repeat-count: int = 0 repeat-time: float = 0.1:
	digital-drum-core freq velocity wave coarse: coarse fine: fine mod-wave: mod-wave mod-freq: mod-freq mod-level: mod-level fm-depth: fm-depth pitch-decay: pitch-decay pitch-depth: pitch-depth pitch-slope: pitch-slope osc-mix: osc-mix mod-decay: mod-decay mod-slope: mod-slope transient-wave: transient-wave transient-freq: transient-freq transient-level: transient-level filter-type: filter-type cutoff: cutoff res: res filter-drive: filter-drive drive: drive decimation: decimation amp-attack: amp-attack amp-decay: amp-decay amp-slope: amp-slope volume-velocity: volume-velocity velocity-depth: velocity-depth velocity-target: velocity-target lfo-wave: lfo-wave lfo-rate: lfo-rate lfo-depth: lfo-depth lfo-offset: lfo-offset lfo-target: lfo-target lfo-retrigger: lfo-retrigger lfo-sync: lfo-sync repeat-count: repeat-count repeat-time: repeat-time
		> * amp

# Original programmable digital drum kit: snare voice (design-music 4.1,
# DDRUM-001/003). The tonal surface plus band-passed noise (`noise-freq`,
# `noise-mix`); shares `digital_drum`'s kernel module with `digital-drum`.
inst digital-snare wave: keyword = :sine coarse: float = 0 fine: float = 0 amp-attack: float = 0.001 amp-decay: float = 0.3 amp-slope: float = 0.6 mod-wave: keyword = :sine mod-freq: float = 2 mod-level: float = 0.5 fm-depth: float = 1 pitch-decay: float = 0.05 pitch-depth: float = 12 pitch-slope: float = 0.5 osc-mix: float = 0.5 mod-decay: float = 0.15 mod-slope: float = 0.5 noise-freq: float = 2500 noise-mix: float = 0.3 transient-wave: keyword = :click transient-freq: float = 4000 transient-level: float = 0.3 filter-type: keyword = :lp cutoff: float = 1200 res: float = 0.3 filter-drive: float = 0 drive: float = 0 decimation: float = 0 volume-velocity: float = 1 velocity-depth: float = 0 velocity-target: keyword = :none lfo-wave: keyword = :sine lfo-rate: float = 4 lfo-depth: float = 0 lfo-offset: float = 0 lfo-target: keyword = :none lfo-retrigger: bool = true lfo-sync: bool = false repeat-count: int = 0 repeat-time: float = 0.1:
	digital-snare-core freq velocity wave coarse: coarse fine: fine mod-wave: mod-wave mod-freq: mod-freq mod-level: mod-level fm-depth: fm-depth pitch-decay: pitch-decay pitch-depth: pitch-depth pitch-slope: pitch-slope osc-mix: osc-mix mod-decay: mod-decay mod-slope: mod-slope noise-freq: noise-freq noise-mix: noise-mix transient-wave: transient-wave transient-freq: transient-freq transient-level: transient-level filter-type: filter-type cutoff: cutoff res: res filter-drive: filter-drive drive: drive decimation: decimation amp-attack: amp-attack amp-decay: amp-decay amp-slope: amp-slope volume-velocity: volume-velocity velocity-depth: velocity-depth velocity-target: velocity-target lfo-wave: lfo-wave lfo-rate: lfo-rate lfo-depth: lfo-depth lfo-offset: lfo-offset lfo-target: lfo-target lfo-retrigger: lfo-retrigger lfo-sync: lfo-sync repeat-count: repeat-count repeat-time: repeat-time
		> * amp

# Original programmable digital drum kit: metal/cymbal voice (design-music
# 4.1, DDRUM-001/004). An inharmonic oscillator bank (its own ratio set,
# spread by `metal-spread`) FM'd by two modulators (`mod*`, `mod2*`) with
# `fm-depth` and a modulation envelope (`mod-decay`, `mod-slope`), plus
# high-passed noise; shares the shared chain with `digital-drum`/
# `digital-snare` (`dsp::ugen::digital_drum::chain`). `filter-type`
# defaults to `:bp`, so `cutoff`/`res` and their velocity/LFO routes are
# live out of the box.
inst digital-metal wave: keyword = :sine coarse: float = 0 fine: float = 0 amp-attack: float = 0.001 amp-decay: float = 0.3 amp-slope: float = 0.6 mod-wave: keyword = :sine mod-freq: float = 2 mod-level: float = 0.5 mod2-wave: keyword = :sine mod2-freq: float = 3 mod2-level: float = 0.3 fm-depth: float = 1 mod-decay: float = 0.15 mod-slope: float = 0.5 metal-spread: float = 0.3 transient-wave: keyword = :click transient-freq: float = 4000 transient-level: float = 0.3 filter-type: keyword = :bp cutoff: float = 1200 res: float = 0.3 filter-drive: float = 0 drive: float = 0 decimation: float = 0 volume-velocity: float = 1 velocity-depth: float = 0 velocity-target: keyword = :none lfo-wave: keyword = :sine lfo-rate: float = 4 lfo-depth: float = 0 lfo-offset: float = 0 lfo-target: keyword = :none lfo-retrigger: bool = true lfo-sync: bool = false repeat-count: int = 0 repeat-time: float = 0.1:
	digital-metal-core freq velocity wave coarse: coarse fine: fine mod-wave: mod-wave mod-freq: mod-freq mod-level: mod-level mod2-wave: mod2-wave mod2-freq: mod2-freq mod2-level: mod2-level fm-depth: fm-depth mod-decay: mod-decay mod-slope: mod-slope metal-spread: metal-spread transient-wave: transient-wave transient-freq: transient-freq transient-level: transient-level filter-type: filter-type cutoff: cutoff res: res filter-drive: filter-drive drive: drive decimation: decimation amp-attack: amp-attack amp-decay: amp-decay amp-slope: amp-slope volume-velocity: volume-velocity velocity-depth: velocity-depth velocity-target: velocity-target lfo-wave: lfo-wave lfo-rate: lfo-rate lfo-depth: lfo-depth lfo-offset: lfo-offset lfo-target: lfo-target lfo-retrigger: lfo-retrigger lfo-sync: lfo-sync repeat-count: repeat-count repeat-time: repeat-time
		> * amp

# Original programmable digital drum kit: hat voice (design-music 4.1,
# DDRUM-001/004). A fixed inharmonic oscillator bank (a distinct original
# ratio set, no `metal-spread`) FM'd by two modulators, plus high-passed
# noise. `hat-open` selects `open-decay` (ringing) or `closed-decay`
# (tight) as the base tail, which `amp-decay` then scales relative to its
# own default, so `amp-decay`/`open-decay`/`closed-decay`/`hat-open` are
# all independently audible (see `dsp::ugen::digital_drum::metal`'s module
# doc comment). Open/closed choke uses the existing `cut` group control,
# not a control declared here. `filter-type` defaults to `:hp`, so
# `cutoff`/`res` and their velocity/LFO routes are live out of the box.
inst digital-hat wave: keyword = :sine coarse: float = 0 fine: float = 0 amp-attack: float = 0.001 amp-decay: float = 0.3 amp-slope: float = 0.6 mod-wave: keyword = :sine mod-freq: float = 2 mod-level: float = 0.5 mod2-wave: keyword = :sine mod2-freq: float = 3 mod2-level: float = 0.3 fm-depth: float = 1 mod-decay: float = 0.15 transient-wave: keyword = :click transient-freq: float = 4000 transient-level: float = 0.3 filter-type: keyword = :hp cutoff: float = 1200 res: float = 0.3 filter-drive: float = 0 drive: float = 0 decimation: float = 0 volume-velocity: float = 1 velocity-depth: float = 0 velocity-target: keyword = :none lfo-wave: keyword = :sine lfo-rate: float = 4 lfo-depth: float = 0 lfo-offset: float = 0 lfo-target: keyword = :none lfo-retrigger: bool = true lfo-sync: bool = false open-decay: float = 0.6 closed-decay: float = 0.08 hat-open: bool = false:
	digital-hat-core freq velocity wave coarse: coarse fine: fine mod-wave: mod-wave mod-freq: mod-freq mod-level: mod-level mod2-wave: mod2-wave mod2-freq: mod2-freq mod2-level: mod2-level fm-depth: fm-depth mod-decay: mod-decay transient-wave: transient-wave transient-freq: transient-freq transient-level: transient-level filter-type: filter-type cutoff: cutoff res: res filter-drive: filter-drive drive: drive decimation: decimation amp-attack: amp-attack amp-decay: amp-decay amp-slope: amp-slope volume-velocity: volume-velocity velocity-depth: velocity-depth velocity-target: velocity-target lfo-wave: lfo-wave lfo-rate: lfo-rate lfo-depth: lfo-depth lfo-offset: lfo-offset lfo-target: lfo-target lfo-retrigger: lfo-retrigger lfo-sync: lfo-sync open-decay: open-decay closed-decay: closed-decay hat-open: hat-open
		> * amp

# Analytic struck-resonator percussion: four bass controls from the
# referenced design, with neutral Vactr names.
inst low-drum kick-frequency: float = 60 kick-punch: float = 0.5 kick-tone: float = 0.5 kick-decay: float = 0.45:
	analog-percussion kick-frequency punch: kick-punch tone: kick-tone decay: kick-decay mode: 0
		> * amp

# Two resonant body modes plus a noise spring; four authored controls.
inst wire-drum snare-frequency: float = 180 snare-tone: float = 0.5 snare-snappy: float = 0.5 snare-decay: float = 0.25:
	analog-percussion snare-frequency tone: snare-tone snappy: snare-snappy decay: snare-decay mode: 1
		> * amp

# The referenced high-hat exposes no authored controls. These four knobs
# are Vactr extensions for its analytic metallic/noise architecture.
inst metal-hat hat-frequency: float = 3900 hat-tone: float = 0.5 hat-decay: float = 0.12 hat-metal: float = 0.7:
	analog-percussion hat-frequency tone: hat-tone decay: hat-decay metal: hat-metal mode: 2
		> * amp

# Plaits templates end in the voice gate; lpg-mode :off is an exact pass-through.
# Analytic variable-spectrum oscillator and paired filters. One bound node
# provides both outputs; aux-out sends the high-pass path to the right channel.
inst filter-voice morph: float = 0.5 timbre: float = 0.5 filter-harmonics: float = 0.5 lpg-mode: keyword = :off lpg-decay: float = 0.5 lpg-color: float = 0.5:
	let p {va-source freq morph: morph > va-filter freq: freq timbre: timbre filter-harmonics: filter-harmonics mode: 0}
	{p :main} > * amp > + {{p :aux} > * amp > vactrol-gate freq velocity lpg-mode: lpg-mode lpg-decay: lpg-decay lpg-color: lpg-color slot: 0 lane: 1 > aux-out}
		> vactrol-gate freq velocity lpg-mode: lpg-mode lpg-decay: lpg-decay lpg-color: lpg-color slot: 0 lane: 0

# Table-free phase distortion: synchronized main and free-running auxiliary.
# The harmonics role uses a distinct name because harmonics is an effect.
inst phase-pair-voice phase-harmonics: float = 0.5 timbre: float = 0.5 morph: float = 0.5 lpg-mode: keyword = :off lpg-decay: float = 0.5 lpg-color: float = 0.5:
	phase-pair freq phase-harmonics: phase-harmonics timbre: timbre morph: morph mode: 0 > * amp
		> + {phase-pair freq phase-harmonics: phase-harmonics timbre: timbre morph: morph mode: 1 > * amp > vactrol-gate freq velocity lpg-mode: lpg-mode lpg-decay: lpg-decay lpg-color: lpg-color slot: 1 lane: 1 > aux-out}
		> vactrol-gate freq velocity lpg-mode: lpg-mode lpg-decay: lpg-decay lpg-color: lpg-color slot: 1 lane: 0

# Fourfold analytic two-operator FM. Main is carrier; aux is a sub oscillator.
# Morph ranges from negative phase feedback to positive modulator feedback. One bound node provides both outputs.
inst fm-pair-voice fm-harmonics: float = 0.5 timbre: float = 0.5 morph: float = 0.5 lpg-mode: keyword = :off lpg-decay: float = 0.5 lpg-color: float = 0.5:
	let p {fm-pair freq fm-harmonics: fm-harmonics timbre: timbre morph: morph mode: 0}
	{p :main} > * amp > + {{p :aux} > * amp > vactrol-gate freq velocity lpg-mode: lpg-mode lpg-decay: lpg-decay lpg-color: lpg-color slot: 10 lane: 1 > aux-out}
		> vactrol-gate freq velocity lpg-mode: lpg-mode lpg-decay: lpg-decay lpg-color: lpg-color slot: 10 lane: 0

# Original 32-configuration six-operator banks. Main and aux intentionally
# duplicate the same signal, matching the source engine's output relationship.
inst six-bank-a-voice six-patch: float = 0 timbre: float = 0.5 morph: float = 0.5 velocity: float = 1 six-sustain: float = 0 lpg-mode: keyword = :off lpg-decay: float = 0.5 lpg-color: float = 0.5:
	six-op-original freq six-patch: six-patch timbre: timbre morph: morph velocity: velocity six-sustain: six-sustain six-bank: 0 > * amp
		> + {six-op-original freq six-patch: six-patch timbre: timbre morph: morph velocity: velocity six-sustain: six-sustain six-bank: 0 > * amp > vactrol-gate freq velocity lpg-mode: lpg-mode lpg-decay: lpg-decay lpg-color: lpg-color slot: 2 lane: 1 > aux-out}
		> vactrol-gate freq velocity lpg-mode: lpg-mode lpg-decay: lpg-decay lpg-color: lpg-color slot: 2 lane: 0

inst six-bank-b-voice six-patch: float = 0 timbre: float = 0.5 morph: float = 0.5 velocity: float = 1 six-sustain: float = 0 lpg-mode: keyword = :off lpg-decay: float = 0.5 lpg-color: float = 0.5:
	six-op-original freq six-patch: six-patch timbre: timbre morph: morph velocity: velocity six-sustain: six-sustain six-bank: 1 > * amp
		> + {six-op-original freq six-patch: six-patch timbre: timbre morph: morph velocity: velocity six-sustain: six-sustain six-bank: 1 > * amp > vactrol-gate freq velocity lpg-mode: lpg-mode lpg-decay: lpg-decay lpg-color: lpg-color slot: 3 lane: 1 > aux-out}
		> vactrol-gate freq velocity lpg-mode: lpg-mode lpg-decay: lpg-decay lpg-color: lpg-color slot: 3 lane: 0

inst six-bank-c-voice six-patch: float = 0 timbre: float = 0.5 morph: float = 0.5 velocity: float = 1 six-sustain: float = 0 lpg-mode: keyword = :off lpg-decay: float = 0.5 lpg-color: float = 0.5:
	six-op-original freq six-patch: six-patch timbre: timbre morph: morph velocity: velocity six-sustain: six-sustain six-bank: 2 > * amp
		> + {six-op-original freq six-patch: six-patch timbre: timbre morph: morph velocity: velocity six-sustain: six-sustain six-bank: 2 > * amp > vactrol-gate freq velocity lpg-mode: lpg-mode lpg-decay: lpg-decay lpg-color: lpg-color slot: 4 lane: 1 > aux-out}
		> vactrol-gate freq velocity lpg-mode: lpg-mode lpg-decay: lpg-decay lpg-color: lpg-color slot: 4 lane: 0

# Original naive/SAM/LPC-like speech models and four Vactr syllable tokens.
# Harmonics 0..1/3 blends the three models; above 1/3 selects token ava,
# omi, era or unu. Main is formant voice, auxiliary is excitation.
inst speech-voice speech-harmonics: float = 0 timbre: float = 0.5 morph: float = 0.5 velocity: float = 1 speech-sustain: float = 0 lpg-mode: keyword = :off lpg-decay: float = 0.5 lpg-color: float = 0.5:
	speech-original freq speech-harmonics: speech-harmonics timbre: timbre morph: morph velocity: velocity speech-sustain: speech-sustain mode: 0 > * amp
		> + {speech-original freq speech-harmonics: speech-harmonics timbre: timbre morph: morph velocity: velocity speech-sustain: speech-sustain mode: 1 > * amp > vactrol-gate freq velocity lpg-mode: lpg-mode lpg-decay: lpg-decay lpg-color: lpg-color slot: 15 lane: 1 > aux-out}
		> vactrol-gate freq velocity lpg-mode: lpg-mode lpg-decay: lpg-decay lpg-color: lpg-color slot: 15 lane: 0

# Integer-series main and organ-series auxiliary additive spectra.
# Timbre sets centroid, morph slope, spectrum-bumps the harmonic emphasis.
inst spectrum-voice timbre: float = 0.5 morph: float = 0.5 spectrum-bumps: float = 0.5 lpg-mode: keyword = :off lpg-decay: float = 0.5 lpg-color: float = 0.5:
	spectrum-pair freq timbre: timbre morph: morph spectrum-bumps: spectrum-bumps mode: 0 > * amp
		> + {spectrum-pair freq timbre: timbre morph: morph spectrum-bumps: spectrum-bumps mode: 1 > * amp > vactrol-gate freq velocity lpg-mode: lpg-mode lpg-decay: lpg-decay lpg-color: lpg-color slot: 12 lane: 1 > aux-out}
		> vactrol-gate freq velocity lpg-mode: lpg-mode lpg-decay: lpg-decay lpg-color: lpg-color slot: 12 lane: 0

# Event-start-reset clocked noise. Main blends LP/HP; aux sums two bandpasses.
inst clock-noise-voice noise-harmonics: float = 0.5 timbre: float = 0.5 morph: float = 0.5 lpg-mode: keyword = :off lpg-decay: float = 0.5 lpg-color: float = 0.5:
	clock-noise-pair freq noise-harmonics: noise-harmonics timbre: timbre morph: morph mode: 0 > * amp
		> + {clock-noise-pair freq noise-harmonics: noise-harmonics timbre: timbre morph: morph mode: 1 > * amp > vactrol-gate freq velocity lpg-mode: lpg-mode lpg-decay: lpg-decay lpg-color: lpg-color slot: 17 lane: 1 > aux-out}
		> vactrol-gate freq velocity lpg-mode: lpg-mode lpg-decay: lpg-decay lpg-color: lpg-color slot: 17 lane: 0

# Triggered dual bass drum: analog main, synthetic auxiliary.
# Event velocity is the accent. A new note retriggers both paths.
inst dual-kick-voice kick-harmonics: float = 0.5 timbre: float = 0.5 morph: float = 0.5 kick-sustain: float = 0 lpg-mode: keyword = :off lpg-decay: float = 0.5 lpg-color: float = 0.5:
	dual-kick-core freq kick-harmonics: kick-harmonics timbre: timbre morph: morph velocity: velocity mode: 0 kick-sustain: kick-sustain > * amp
		> + {dual-kick-core freq kick-harmonics: kick-harmonics timbre: timbre morph: morph velocity: velocity mode: 1 kick-sustain: kick-sustain > * amp > vactrol-gate freq velocity lpg-mode: lpg-mode lpg-decay: lpg-decay lpg-color: lpg-color slot: 21 lane: 1 > aux-out}
		> vactrol-gate freq velocity lpg-mode: lpg-mode lpg-decay: lpg-decay lpg-color: lpg-color slot: 21 lane: 0

# Plaits position 22 snare stages, analog main and synthetic auxiliary.
# Event velocity supplies accent; a new note retriggers both paths.
inst dual-snare-voice snare-harmonics: float = 0.5 timbre: float = 0.5 morph: float = 0.5 snare-sustain: float = 0 lpg-mode: keyword = :off lpg-decay: float = 0.5 lpg-color: float = 0.5:
	snare-pair-core freq snare-harmonics: snare-harmonics timbre: timbre morph: morph velocity: velocity mode: 0 snare-sustain: snare-sustain > * amp
		> + {snare-pair-core freq snare-harmonics: snare-harmonics timbre: timbre morph: morph velocity: velocity mode: 1 snare-sustain: snare-sustain > * amp > vactrol-gate freq velocity lpg-mode: lpg-mode lpg-decay: lpg-decay lpg-color: lpg-color slot: 22 lane: 1 > aux-out}
		> vactrol-gate freq velocity lpg-mode: lpg-mode lpg-decay: lpg-decay lpg-color: lpg-color slot: 22 lane: 0

# Plaits position 23 hi-hat stages: square-noise main, ring-mod auxiliary.
# Event velocity supplies accent and each note retriggers both envelopes.
inst dual-hat-voice hat-harmonics: float = 0.5 timbre: float = 0.5 morph: float = 0.5 hat-sustain: float = 0 lpg-mode: keyword = :off lpg-decay: float = 0.5 lpg-color: float = 0.5:
	hat-pair-core freq hat-harmonics: hat-harmonics timbre: timbre morph: morph velocity: velocity mode: 0 hat-sustain: hat-sustain > * amp
		> + {hat-pair-core freq hat-harmonics: hat-harmonics timbre: timbre morph: morph velocity: velocity mode: 1 hat-sustain: hat-sustain > * amp > vactrol-gate freq velocity lpg-mode: lpg-mode lpg-decay: lpg-decay lpg-color: lpg-color slot: 23 lane: 1 > aux-out}
		> vactrol-gate freq velocity lpg-mode: lpg-mode lpg-decay: lpg-decay lpg-color: lpg-color slot: 23 lane: 0

# Eight ranked grain voices; burst on each event or continuous cloud.
# Main is BLEP saw, auxiliary is analytic sine.
inst swarm-voice swarm-spread: float = 0.5 timbre: float = 0.5 morph: float = 0.5 swarm-continuous: float = 0 lpg-mode: keyword = :off lpg-decay: float = 0.5 lpg-color: float = 0.5:
	swarm-pair-core freq swarm-spread: swarm-spread timbre: timbre morph: morph mode: 0 swarm-continuous: swarm-continuous > * amp
		> + {swarm-pair-core freq swarm-spread: swarm-spread timbre: timbre morph: morph mode: 1 swarm-continuous: swarm-continuous > * amp > vactrol-gate freq velocity lpg-mode: lpg-mode lpg-decay: lpg-decay lpg-color: lpg-color slot: 16 lane: 1 > aux-out}
		> vactrol-gate freq velocity lpg-mode: lpg-mode lpg-decay: lpg-decay lpg-color: lpg-color slot: 16 lane: 0

# Plaits position 8 roles: variable square/saw main, sync difference aux. One bound node provides both outputs.
inst analog-pair-voice analog-detune: float = 0.5 timbre: float = 0.5 morph: float = 0.5 lpg-mode: keyword = :off lpg-decay: float = 0.5 lpg-color: float = 0.5:
	let p {analog-pair-core freq analog-detune: analog-detune timbre: timbre morph: morph mode: 0}
	{p :main} > * amp > + {{p :aux} > * amp > vactrol-gate freq velocity lpg-mode: lpg-mode lpg-decay: lpg-decay lpg-color: lpg-color slot: 8 lane: 1 > aux-out}
		> vactrol-gate freq velocity lpg-mode: lpg-mode lpg-decay: lpg-decay lpg-color: lpg-color slot: 8 lane: 0

# Four-note chord with inversion and fifteen original procedural timbres. One bound node provides both outputs.
inst chord-layer-voice layer-chord: float = 0.5 timbre: float = 0.5 morph: float = 0.5 lpg-mode: keyword = :off lpg-decay: float = 0.5 lpg-color: float = 0.5:
